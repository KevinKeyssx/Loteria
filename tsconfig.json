{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [ "ESNext", "DOM", "DOM.Iterable" ],
		"skipLibCheck": true,
		"allowJs": true,
		"checkJs": true,
		"isolatedModules": true,
		"noEmit": true,
		"strict": true
	},
	"include": [ "src/**/*.d.ts", "src/**/*.ts", "src/**/*.js", "src/**/*.svelte" ],
	"exclude": [ "node_modules", "components", "lib", "dist" ]
}
